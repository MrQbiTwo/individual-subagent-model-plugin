{
  "name": "codex-individual-subagent-model-plugin",
  "version": "1.0.0",
  "description": "Per-subagent model routing for the Codex CLI/app, built on the repo-root universal core.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./catalog": "./dist/catalog.js",
    "./providers": "./dist/providers.js",
    "./argv": "./dist/argv.js",
    "./rpc": "./dist/rpc.js",
    "./ports": "./dist/ports.js"
  },
  "imports": {
    "#universal": "./dist/universal/index.js",
    "#universal/*": "./dist/universal/*.js"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.universal.json && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.universal.json && tsc -p tsconfig.json --noEmit",
    "probe": "node tools/codex_probe.mjs contract"
  }
}
