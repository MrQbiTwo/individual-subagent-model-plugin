# OpenCode 2.3.2 bundles a runtime that satisfies the OpenTUI peer dependencies.
# @opentui/core 0.8.4 declares `node >=26.4.0`, but host machines run Node 22/24.
# npm therefore emits an EBADENGINE warning during install. That warning is
# expected and non-fatal: the plugin is loaded by OpenCode's bundled runtime,
# not by the host Node binary. Keep strict engine checks disabled so that
# `npm ci` succeeds on every supported runner.
engine-strict=false
